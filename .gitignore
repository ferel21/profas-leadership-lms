# Local Netlify folder
.netlify

# Regenerated by Next.js on every run, and its contents differ between dev and
# build because next.config.ts intentionally splits distDir (.next-dev vs .next),
# so the tracked copy flip-flops on every `npm run dev`.
next-env.d.ts

# Throwaway diagnostic scripts, harnesses and screenshots written at the repo
# root during local investigation (hardcoded sandbox paths and localhost URLs).
# Nothing shipped lives at the repo root under either name, and real tooling
# belongs in scripts/ -- so ignore the two prefixes rather than chasing
# individual filenames and extensions.
/_*
/probe*
.github/workflows/build-apk.yml
.github/workflows_backup/
