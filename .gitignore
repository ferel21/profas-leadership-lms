# Local Netlify folder
.netlify

# Regenerated by Next.js on every run, and its contents differ between dev and
# build because next.config.ts intentionally splits distDir (.next-dev vs .next),
# so the tracked copy flip-flops on every `npm run dev`.
next-env.d.ts

# Throwaway diagnostic scripts/screenshots written at the repo root during
# local investigation (hardcoded sandbox paths and localhost URLs). Underscore
# prefix is the convention for these; nothing shipped lives at the root with one.
/_*.mjs
/_*.cjs
/_*.js
/_*.png
